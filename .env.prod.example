# ==============================================================================
# GeoTani — Production Environment Configuration (.env.prod)
# Copy this file to .env.prod on your VPS:
#   cp .env.prod.example .env.prod
# ==============================================================================

# Public Domain Name (Caddy automatically requests HTTPS certificates for this domain)
DOMAIN_NAME=geotani.cloud

# Allowed CORS Origins (comma-separated for API requests)
CORS_ORIGINS=https://geotani.cloud,https://www.geotani.cloud

# Database Credentials
POSTGRES_USER=geotani
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_SECURE_RANDOM_PASSWORD_IN_PRODUCTION
POSTGRES_DB=geotani
