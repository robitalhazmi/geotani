# GeoTani API — Python FastAPI container
FROM python:3.12-slim AS base

# Install GDAL system dependencies (needed for rasterio, geopandas)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gdal-bin \
    libgdal-dev \
    gcc \
    g++ \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for secure runtime
RUN useradd --create-home --shell /bin/bash appuser

WORKDIR /app

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code, ETL modules, and automation scripts
COPY api/ ./api/
COPY etl/ ./etl/
COPY scripts/ ./scripts/

# Create data directories with permissions for appuser
RUN mkdir -p /app/data/raw /app/data/processed \
    && chmod +x ./scripts/*.sh \
    && chown -R appuser:appuser /app

USER appuser

EXPOSE 8000

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
